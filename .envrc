# direnv: loads the Floci env and the group id when you cd into this repo.
# After cloning (or after any edit to this file), run once:  direnv allow
# Without direnv (Codespace, Windows): source env.sh && export GROUP=...

# Floci endpoint, test/test keys, region, REGISTRY, AMI/TYPE
watch_file env.sh
source env.sh >/dev/null

# Group id, shared by the whole group: it prefixes every resource name
export GROUP=g11

# Optional personal overrides, not committed (e.g. another GROUP to test)
source_env_if_exists .envrc.local

[ "$GROUP" = gXX ] && log_error "GROUP is still the placeholder gXX: set your real group id in .envrc"
